{
	"schemaVersion": 1,
	"id": "letterbanners",
	"version": "${version}",
	"name": "Letter Banners",
	"description": "Alphabet banners built from vanilla banner patterns. Adds /letterbanner, which opens the picker dialog or spells a whole word in one go.",
	"authors": [
		"256 Arts Developer"
	],
	"contact": {
		"sources": "https://github.com/256Arts/Minecraft-Letter-Banners",
		"issues": "https://github.com/256Arts/Minecraft-Letter-Banners/issues"
	},
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.arts256.letterbanners.fabric.LetterBannersFabric"
		]
	},
	"mixins": [
		"letterbanners.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-command-api-v2": "*"
	}
}
