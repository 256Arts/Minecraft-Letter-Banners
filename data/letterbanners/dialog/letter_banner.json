  "columns": 3,
  "actions": [
    {
      "label": {
        "text": "Make A-Z"
      },
      "tooltip": {
        "text": "All Letters (A-Z). One banner per character, 26 in all, in the colors picked above."
      },
      "width": 98,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function letterbanners:sets/letters {fg:\"$(fg)\",bg:\"$(bg)\",fade:\"$(fade)\",size:\"$(size)\"}"
      }
    },
    {
      "label": {
        "text": "Make 0-9"
      },
      "tooltip": {
        "text": "All Digits (0-9). One banner per character, 10 in all, in the colors picked above."
      },
      "width": 98,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function letterbanners:sets/digits {fg:\"$(fg)\",bg:\"$(bg)\",fade:\"$(fade)\",size:\"$(size)\"}"
      }
    },
    {
      "label": {
        "text": "Make Symbols"
      },
      "tooltip": {
        "text": "All Symbols. One banner per character, 20 in all, in the colors picked above."
      },
      "width": 98,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function letterbanners:sets/symbols {fg:\"$(fg)\",bg:\"$(bg)\",fade:\"$(fade)\",size:\"$(size)\"}"
      }
    },
    {
      "label": {
        "text": "Make Banners"
      },
      "tooltip": {
        "text": "One banner per character. The dialog closes once they are given."
      },
      "width": 200,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function letterbanners:submit {text:\"$(text)\",fg:\"$(fg)\",bg:\"$(bg)\",fade:\"$(fade)\",size:\"$(size)\"}"
      }
    }
  ]
